# Copy to .env (gitignored). Run with: uv run --env-file .env scanner scan <url>

# Contact URL shown in our User-Agent: AgentReadyScanner/<version> (+<url>)
SCANNER_CONTACT_URL=https://example.invalid/replace-me

# V1 AI visibility (build step 3, --visibility): all LLM calls go through OpenRouter.
# Create a key at https://openrouter.ai/settings/keys and give it a credit LIMIT of 10 (USD)
# with a MONTHLY reset, so OpenRouter itself refuses calls (HTTP 402) beyond the budget.
# Settings: config/visibility.toml
# OPENROUTER_API_KEY=
# Optional LangSmith tracing (never logs full page HTML or personal data)
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=

# Service name in the HTML report header (default "Agent-Ready Scan"; final name still open)
# SCANNER_BRAND=
