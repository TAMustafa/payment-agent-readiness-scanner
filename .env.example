# Copy to .env (gitignored). Only needed for the V1 visibility check (build step 3).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# PERPLEXITY_API_KEY=

# Optional LangSmith tracing (never logs full page HTML or personal data)
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=

# Contact URL shown in our User-Agent: AgentReadyScanner/<version> (+<url>)
# Run with: uv run --env-file .env scanner scan <url>
SCANNER_CONTACT_URL=https://example.invalid/replace-me
